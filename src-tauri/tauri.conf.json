{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scrapelium",
  "version": "0.1.0",
  "identifier": "com.scrapelium.app",
  "build": {
    "frontendDist": "../apps/web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @scrapelium/web dev",
    "beforeBuildCommand": "pnpm --filter @scrapelium/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Scrapelium",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/server": "server",
      "resources/node": "node"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}